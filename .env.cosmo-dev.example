# Cosmo OS (dev) — default for creating migrations & team local dev
# Copy to .env.cosmo-dev and fill in real values (gitignored)

APP_BASE_URL="https://localhost:3000"
NEXT_PUBLIC_APP_NAME="Cosmo OS"
NEXT_PUBLIC_APP_INITIALS="CO"

# Neon — Cosmo OS shared dev database
DATABASE_URL="postgresql://neondb_owner:<password>@your-cosmo-dev-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:<password>@your-cosmo-dev.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Auth0 — Cosmo OS dev tenant
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_DATABASE_CONNECTION=Username-Password-Authentication

# Maileroo
MAILEROO_API_KEY=
MAILEROO_FROM_EMAIL=noreply@yourdomain.com

# Shopify (Cosmetics store webhooks)
SHOPIFY_WEBHOOK_SECRET=
# Shopify Admin API — required for cancel_order action (Private App or Custom App access token)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Mobile app order history (GET /api/merchant/orders, header X-API-Key).
# MERCHANT_ORDERS_API_KEY=
# MERCHANT_ORDERS_COMPANY_ID=

# Cloudinary (Cosmo media)
CLOUDINARY_URL=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ERPNext (Cosmo instance — optional)
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_BANK_TRANSFER_MOP=Wire Transfer
ERPNEXT_CASH_MOP=Cash
ERPNEXT_COD_MOP=Cash On Delivery
ERPNEXT_CARD_DELIVERY_MOP=Credit Card
ERPNEXT_TAXES_AND_CHARGES=
ERPNEXT_SHIPPING_RULE=
ERPNEXT_INCOMING_WEBHOOK_SECRET=
# ERPNEXT_KOKO_ORDER_SYNC_METHOD=bank_recon_sync_koko_orders

# Optional
DB_REQUEST_SLOW_MS=400
PRISMA_LOG_SLOW_QUERIES=false
PRISMA_SLOW_QUERY_MS=250
PRISMA_SLOW_QUERY_SAMPLE_RATE=1
ENABLE_PERF_LOGS=false

# Wishlist Buddy Shopify app: client secret (Partner dashboard → app → Client credentials).
# Verifies app proxy form posts and the inventory_levels/update webhook. Leave empty to disable.
# Client ID lets Cosmo OS get its own Admin API token per store (client credentials grant).
WISHLIST_BUDDY_SHOPIFY_CLIENT_ID=
WISHLIST_BUDDY_SHOPIFY_API_SECRET=
# ERP warehouses that feed Shopify (never shown as "stock elsewhere"), comma-separated.
WISHLIST_BUDDY_EXCLUDE_WAREHOUSES=Main Warehouse - Cosmo
# Optional test-store aliases: <store-handle>=<linked-store-handle>, comma-separated.
WISHLIST_BUDDY_STORE_ALIASES=
# Stock check on new requests: erp (default) | off | demo (fake stock, no ERP calls; not allowed in production builds).
WISHLIST_BUDDY_STOCK_LOOKUP=erp
# Staff requests: storefront base URL for product links in back-in-stock emails (e.g. https://cosmetics.lk).
WISHLIST_BUDDY_STOREFRONT_URL=
# Stock list order: priority warehouses first, then ERP instances whose label contains these hints, in order.
WISHLIST_BUDDY_PRIORITY_WAREHOUSES=Main Warehouse - Cosmo
WISHLIST_BUDDY_ERP_ORDER=ERP_2,ERP_1
