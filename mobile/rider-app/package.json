{
  "name": "cosmo-rider-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "verify:release": "node scripts/verify-release-config.mjs",
    "build:android:apk": "npm run verify:release && npx eas-cli build --platform android --profile apk",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:staging": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "update:staging": "npx eas-cli update --channel staging --non-interactive",
    "update:production": "npx eas-cli update --channel production --non-interactive",
    "submit:android:production": "npx eas-cli submit --platform android --profile production",
    "env:staging": "npx eas-cli env:list --environment preview",
    "env:production": "npx eas-cli env:list --environment production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "~54.0.36",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "~29.0.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.6",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
